# Nothing personal belongs in this repository.
marks.txt
# Written next to the installed addon while a sweep or a capability check runs. Results
# belong in data/verification.sqlite3, not in a scratch file with a character's position in it.
verify.csv
answers.txt
cmd.txt
*.log
logs/
config/
settings/
.DS_Store
# Ashita writes per-character settings next to the addon; those hold character names.
Vanaguide/settings/
Vanaguide/config/
__pycache__/
*.pyc

# Navigation grids, built by tools/gen_navgrid.py from LandSandBoat's navmeshes.
# They are derived from Square Enix's map geometry by way of a GPL-3.0 project, so they are
# generated on the machine that has them and never committed here. See docs/NAVMESH.md.
Vanaguide/data/nav/
*.vgnav
