# Nothing personal belongs in this repository.
marks.txt
*.log
logs/
config/
settings/
.DS_Store
# Ashita writes per-character settings next to the addon; those hold character names.
Vanaguide/settings/
Vanaguide/config/
# generated from LandSandBoat navmeshes (GPL + SE geometry): build locally, never ship
Vanaguide/data/nav/

# personal / local-server secrets if staged into this tree by mistake
accounts.json
**/.dbpass
.dbpass
*.dbpass
*.personal.json

# Local capture/test output, account settings and credentials.
.env
.env.*
CREDENTIALS.md
secrets.json
retroachievements.json
retroachievements-snapshots.json
dialogue.jsonl
__pycache__/
*.pyc
results/guided-*/

# Local credential stores are never source artifacts.
**/CREDENTIALS.md
**/secrets.json
# Additional Drive workspace exclusions
# Runtime command/chat captures can contain player text and test actions.
Vanaguide/*.txt
# Python test and generator bytecode
*.py[cod]
# Local secrets: the RetroAchievements Web API key comes from the environment or the Keychain
# (tools/ra_api.py), never a file in this tree.
.env
.env.*
*api-key*.txt
